# Copy to .env.local and adjust for your environment.
#
# Local development (docker compose up -d):
DATABASE_URL=postgres://inventory:inventory@127.0.0.1:15433/inventory
#
# Neon: copy the pooled connection string from the project dashboard. Keep
# ?sslmode=require, and prefer the "-pooler" host so short-lived serverless
# connections do not exhaust the compute's connection limit.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
SESSION_SECRET=replace-with-a-long-random-string
